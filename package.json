  "scripts": {
    "dev": "tsx server.entry.ts",
    "start": "node server.js --production",
    "build": "bun ./node_modules/vite/bin/vite.js build && bun ./node_modules/esbuild/bin/esbuild server.entry.ts --bundle --platform=node --format=esm --packages=external --target=node24 --outfile=server.js",
    "preview": "node server.js --production",
    "clean": "rm -rf dist server.js",
    "lint": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
