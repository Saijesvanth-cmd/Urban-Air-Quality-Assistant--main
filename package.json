    "@types/pg": "^8.23.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "gsap": "^3.15.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
