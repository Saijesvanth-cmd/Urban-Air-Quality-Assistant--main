# Required for Gemini-powered chat. Keep this server-only; do not use a VITE_ prefix.
GEMINI_API_KEY=""

# Required for PostgreSQL-backed household profiles, routines, and query history.
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_SSL="true"

# Required on Vercel for Firebase Admin ID-token verification. Store the entire service
# account JSON as a Vercel encrypted environment variable; never commit it to the repo.
FIREBASE_SERVICE_ACCOUNT=""

# Optional HTTP listener port (defaults to 3000).
PORT=3000

# Leave blank for the combined, same-origin Vercel deployment.
VITE_API_BASE_URL=""

# Only needed if intentionally allowing a separate browser origin. For same-origin hosting,
# leave empty. Use an exact origin, without a trailing slash.
CORS_ORIGIN=""
