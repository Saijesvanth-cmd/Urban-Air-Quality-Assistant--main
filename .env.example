# Optional: enables the server-side Gemini AI advisor.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Required for authenticated household profiles, routines, and query history.
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Optional HTTP listener port (defaults to 3000).
PORT=3000

# Optional API origin for split frontend/backend deployments. Leave blank for same-origin hosting.
VITE_API_BASE_URL=""

# Set to the exact frontend origin only when the API is hosted on a different origin.
CORS_ORIGIN=""
