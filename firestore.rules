rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredCityId', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'preferredCityId', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 100
        && isValidId(data.preferredCityId) && data.preferredCityId.size() <= 64
        && data.updatedAt is timestamp;
    }

    function isValidObservation(data) {
      return data.keys().hasAll(['uid', 'placeName', 'kind', 'cityName', 'aqi', 'pm25', 'createdAt'])
        && data.keys().hasOnly(['uid', 'placeName', 'kind', 'cityName', 'aqi', 'pm25', 'notes', 'createdAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.uid == request.auth.uid
        && data.placeName is string && data.placeName.size() > 0 && data.placeName.size() <= 140
        && data.kind is string && data.kind in ['green_zone', 'sensor_station', 'neighborhood']
        && data.cityName is string && data.cityName.size() > 0 && data.cityName.size() <= 80
        && data.aqi is number && data.aqi >= 0 && data.aqi <= 2000
        && data.pm25 is number && data.pm25 >= 0 && data.pm25 <= 2000
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 280))
        && data.createdAt is timestamp;
    }

    // Connection validation document (read-only)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Owner-only user profile document
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredCityId', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      // Owner-only saved green zones & station observations
      match /observations/{observationId} {
        allow get: if isValidId(userId) && isValidId(observationId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(observationId)
          && isOwner(userId)
          && isValidObservation(incoming())
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(observationId) && isOwner(userId);
      }
    }
  }
}
